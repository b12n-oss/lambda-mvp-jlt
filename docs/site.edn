;; Configuration for the documentation site, read by the docs-engine
;; (https://github.com/b12n-oss/docs-engine).
;;
;; Build it locally with `jolt site:build`/`jolt site:serve`. CI builds it
;; on every push and pull request from .github/workflows/site.yml, and
;; publishes from main: the PUBLISH_SITE repository variable is "true"
;; and GitHub Pages is enabled.
{;; :base-path is what makes this a project site rather than an org one.
 ;; The site is served at https://b12n-oss.github.io/lambda-mvp-jlt/, so
 ;; every URL the engine emits needs that prefix. Leave it out and the
 ;; pages still render, but each one loads the ORGANIZATION site's
 ;; stylesheet and every asset 404s. The workflow has a check for exactly
 ;; this.
 :base-path   "/lambda-mvp-jlt"

 :title       "lambda-mvp-jlt"
 :description "A shareable AWS Lambda custom runtime in Jolt, with a jolt bench tool for reproducing a cold-vs-warm boot-time comparison against your own AWS account."}
